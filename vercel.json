{
  "version": 2,
  "name": "metododopai360",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "app",
  "installCommand": "npm install",

  "redirects": [
    { "source": "/landing/(.*)",       "destination": "/tela_catalogo_concursos", "permanent": true },
    { "source": "/landing",            "destination": "/tela_catalogo_concursos", "permanent": true },
    { "source": "/apple-touch-icon.png", "destination": "/app-icon.png",          "permanent": false },
    { "source": "/icon-192.png",       "destination": "/app-icon.png",            "permanent": false },
    { "source": "/icon-512.png",       "destination": "/app-icon.png",            "permanent": false },
    { "source": "/favicon-32.png",     "destination": "/app-icon.png",            "permanent": false }
  ],

  "rewrites": [
    { "source": "/api/tts",       "destination": "/api/tts"       },
    { "source": "/api/config",    "destination": "/api/config"    },
    { "source": "/api/whatsapp",  "destination": "/api/whatsapp"  },

    { "source": "/missao",                  "destination": "/missao.html"                  },
    { "source": "/rota_estudos",            "destination": "/rota_estudos.html"            },
    { "source": "/teoria_360",              "destination": "/teoria_360.html"              },
    { "source": "/treinamento_360",         "destination": "/treinamento_360.html"         },
    { "source": "/tela_catalogo_concursos", "destination": "/tela_catalogo_concursos.html" },
    { "source": "/acesso_liberado",         "destination": "/acesso_liberado.html"         },
    { "source": "/tela_gps_concurso",       "destination": "/tela_gps_concurso.html"       },
    { "source": "/tela_perfil",             "destination": "/tela_perfil.html"             }
  ],

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*"                   },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS"    },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type"        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff"                     },
        { "key": "X-Frame-Options",        "value": "DENY"                        },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
